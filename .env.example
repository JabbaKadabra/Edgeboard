# edgeboard settings. Copy to .env and uncomment what you want to change.
#
# Loaded by the server (from the working directory, or EDGEBOARD_ENV_FILE) and
# by both systemd units via EnvironmentFile. Real environment variables win
# over this file. Format: KEY=value, one per line, "#" starts a comment.
#
# There are no secrets to put here: the Claude usage panel reads the OAuth
# token from ~/.claude/.credentials.json on its own.

# --- server -----------------------------------------------------------------
# Keep the host on loopback; the server has no authentication.
#EDGEBOARD_HOST=127.0.0.1
#EDGEBOARD_PORT=8765

# Where Claude Code keeps sessions, transcripts and credentials.
#EDGEBOARD_CLAUDE_DIR=~/.claude

# MPRIS player name for playerctl (spotify, vlc, firefox, ...).
#EDGEBOARD_SPOTIFY_PLAYER=spotify

# "Up next" list. MPRIS has no queue, so it comes from the Spotify Web API:
# run scripts/spotify_auth.py once (needs a free Spotify developer app) and it
# writes this token file. Without the file the list stays off.
#EDGEBOARD_SPOTIFY_TOKEN_FILE=~/.config/edgeboard/spotify-token.json
#EDGEBOARD_SPOTIFY_QUEUE_INTERVAL=10

# Claude usage-limits endpoint and poll intervals (seconds).
#EDGEBOARD_USAGE_URL=https://api.anthropic.com/api/oauth/usage
#EDGEBOARD_USAGE_INTERVAL=60
#EDGEBOARD_TIMELINE_INTERVAL=30
#EDGEBOARD_SESSIONS_INTERVAL=2
#EDGEBOARD_SPOTIFY_INTERVAL=1
#EDGEBOARD_SYSTEM_INTERVAL=1

# How many session cards the page shows (working first, then idle, then done)
# and how many finished sessions from today are considered at all. Sessions
# beyond either cap are still counted in the "N today" summary.
#EDGEBOARD_SESSIONS_SHOWN=4
#EDGEBOARD_DONE_SESSIONS_LIMIT=12

# Canned data, no Claude / Spotify / sensors needed.
#EDGEBOARD_DEMO=0

# Attention alerts when a session switches to waiting for you or needing
# permission: a chime on the panel, and/or a desktop notification via notify-send.
#EDGEBOARD_ALERT_SOUND=0
#EDGEBOARD_ALERT_NOTIFY=0

# Follow-up buttons on idle session cards, "label=text|label=text". The text
# is sent to the session as a plain prompt (slash commands do not run that
# way, so phrase them as instructions). Unset = the built-in list:
# continue / commit / tests / summary / yes.
#EDGEBOARD_PRESETS=continue=Continue with the next step.|tests=Run the test suite and fix whatever fails.

# How long scripts/edgeboard-hook.py waits for a tap on the panel when Claude
# asks a question, before the terminal dialog takes over (seconds).
#EDGEBOARD_ANSWER_WAIT=90

# Context gauge on the session cards: the window of models without a [1m]
# marker (tokens) and the utilization (%) from which it turns amber (red at +10).
#EDGEBOARD_CONTEXT_WINDOW=200000
#EDGEBOARD_CONTEXT_WARN=80

# Git pane: today's commits are read from the repositories of the sessions on
# the panel; add more repositories here (":"-separated paths) and set how
# often git log runs (seconds).
#EDGEBOARD_GIT_REPOS=~/dotfiles:~/blog
#EDGEBOARD_GIT_INTERVAL=30

# --- kiosk (scripts/kiosk.sh, edgeboard-kiosk.service) --------------------------
# X,Y position of the Xeneon Edge in the monitor layout (xrandr --listmonitors).
# Only used under X11; on Wayland add a compositor rule for class "edgeboard".
#EDGEBOARD_DISPLAY_OFFSET=0,0
#EDGEBOARD_DISPLAY_SIZE=2560,720

# Dashboard URL the kiosk opens and browser binary to use.
#EDGEBOARD_URL=http://127.0.0.1:8765
#EDGEBOARD_BROWSER=chromium

# Open Chromium's DevTools protocol on this loopback port so the end-to-end
# tests can drive the live panel (EDGEBOARD_KIOSK_CDP=http://127.0.0.1:9222
# pytest -m kiosk). No auth on that port: leave it unset unless you use it.
#EDGEBOARD_KIOSK_DEBUG_PORT=9222
